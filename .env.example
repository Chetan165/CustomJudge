# ── API ────────────────────────────────────────────────────────────
PORT=2358
NODE_ENV=development

# ── Judge0 fallback (non-C++ languages proxy here verbatim) ────────
JUDGE0_FALLBACK_URL=http://localhost:2358
JUDGE0_FALLBACK_AUTH_TOKEN=

# ── Redis / BullMQ ─────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── customJudge's own Postgres (submissions, results) ──────────────
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=customjudge
PGUSER=customjudge
PGPASSWORD=customjudge

# ── Platform Postgres (read-only: testcase source of truth) ────────
# Points at your coding platform's DB so the judge can lazily pull
# testcases for a problem on cache miss.
PLATFORM_DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/platform

# ── Storage roots (worker-local disk) ──────────────────────────────
DATA_ROOT=/var/lib/customjudge
# On Windows dev, override to something like: C:\\Users\\you\\customjudge-data

# ── Sandbox ────────────────────────────────────────────────────────
# isolate = real (Linux only). mock = dev-only child_process driver.
SANDBOX_DRIVER=mock
ISOLATE_BIN=/usr/local/bin/isolate
BOX_ID_MIN=0
BOX_ID_MAX=99

# ── Worker identity + concurrency ──────────────────────────────────
# Set per worker host when running multiple nodes. Blank = shared queue.
NODE_ID=
COMPILE_CONCURRENCY=2
EXECUTE_CONCURRENCY=4

# ── Callback delivery ──────────────────────────────────────────────
# Your platform's handler decodes unconditionally, so emit base64.
CALLBACK_BASE64=true
CALLBACK_METHOD=POST
CALLBACK_MAX_ATTEMPTS=5
CALLBACK_AUTH_HEADER=
CALLBACK_AUTH_TOKEN=

# ── Compile cache ──────────────────────────────────────────────────
BINARY_CACHE_MAX_BYTES=2147483648
CXX_COMPILER=/usr/bin/g++
CXX_FLAGS=-std=c++17 -O2 -w -lm -static -s
JavaCompiler=/usr/bin/javac
JavaExecutable=/usr/bin/java
JavaFlags=-encoding=UTF-8
JavaJar=/usr/lib/jvm/java-11-openjdk-amd64/bin/jar
